# Database (Required)
# Get this from Neon.tech or your local PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Cron Job Secret (Required for /api/cron/rollover)
# Generate a random long string
CRON_SECRET=your-random-secret-here

# Web Push Notifications (Optional)
# Run `npm run gen-vapid` to generate these
# Without these, in-app notifications still work, but push won't be delivered
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# Development (Optional)
# NODE_ENV=development
